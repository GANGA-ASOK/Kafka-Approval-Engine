# Copy to .env and adjust. Every value is optional; defaults match docker-compose on localhost.

# Infrastructure
MONGODB_URL=mongodb://localhost:27017
DATABASE_NAME=relay
REDIS_URL=redis://localhost:6379/0
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Auth (change SECRET_KEY outside local dev)
SECRET_KEY=change-me-to-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
BCRYPT_ROUNDS=12

# HTTP (comma-separated list)
CORS_ORIGINS=http://localhost:5173

# Eventing: "kafka" or "memory" (in-process bus, no Kafka needed)
EVENT_BUS=kafka
# Run consumers + SLA monitor inside the API process (set false when using `python -m app.workers`)
RUN_WORKERS=true
SLA_CHECK_INTERVAL_SECONDS=15
MAX_EVENT_RETRIES=3
RETRY_BACKOFF_SECONDS=2
SEED_DEMO_DATA=true

# Kafka tuning
KAFKA_TOPIC_PARTITIONS=3
KAFKA_REPLICATION_FACTOR=1
KAFKA_CONNECT_RETRY_MAX_SECONDS=30
KAFKA_PUBLISH_TIMEOUT_SECONDS=5
OUTBOX_RELAY_INTERVAL_SECONDS=3
